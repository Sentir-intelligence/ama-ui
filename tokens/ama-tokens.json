        "lineHeight": "16px",
        "fontWeight": 400,
        "letterSpacing": "0.005em"
      },
      "$extensions": {
        "ama": {
          "densityDriven": true
        }
      }
    },
    "overline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{density.*.caption}",
        "lineHeight": "16px",
        "fontWeight": 600,
        "letterSpacing": "0.06em"
      },
      "$extensions": {
        "ama": {
          "textTransform": "uppercase",
          "densityDriven": true,
          "usage": "section labels only, never table headers"
        }
      }
    },
    "table-header": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
