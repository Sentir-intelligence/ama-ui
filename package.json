{
  "name": "ama-ui",
  "version": "0.3.4",
  "private": true,
  "description": "AMA Precast design tokens and component registry (shadcn + Tailwind v4).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "contrast": "node scripts/check-contrast.mjs",
    "css": "tailwindcss -i app/globals.css -o .build/app.css",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "test": "vitest run",
    "registry": "shadcn build -o public/r",
    "check": "npm run tokens:check && npm run contrast && npm run typecheck && npm run lint && npm run css && npm test && npm run registry:check",
    "changeset": "changeset",
    "playground": "vite playground",
    "playground:build": "vite build playground",
    "registry:check": "node scripts/check-registry.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.8"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.36.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@tailwindcss/cli": "^4.1.13",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.36.0",
    "eslint-plugin-better-tailwindcss": "^4.0.0",
    "globals": "^17.13.0",
    "jsdom": "^27.0.0",
    "shadcn": "^3.3.1",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}
